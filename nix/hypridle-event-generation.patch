+static void spawnIdle(const std::string& args, uint64_t generation) {
+    Debug::log(LOG, "Executing idle generation {}: {}", generation, args);
+
+    Hyprutils::OS::CProcess proc("/bin/sh", {"-c", args});
+    proc.addEnv("HYPRIDLE_GENERATION", std::to_string(generation));
+    if (!proc.runSync()) {
+        Debug::log(ERR, "Failed run idle generation {}: {}", generation, args);
+        return;
+    }
+    if (proc.exitCode() != 0)
+        Debug::log(ERR, "Idle generation {} exited {}: {}", generation, proc.exitCode(), proc.stdErr());
+    else
+        Debug::log(LOG, "Idle generation {} completed", generation);
+}
